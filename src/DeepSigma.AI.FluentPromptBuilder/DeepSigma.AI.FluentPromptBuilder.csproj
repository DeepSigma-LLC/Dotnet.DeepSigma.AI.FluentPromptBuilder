<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DeepSigma.AI.FluentPromptBuilder</RootNamespace>
    <AssemblyName>DeepSigma.AI.FluentPromptBuilder</AssemblyName>
    <PackageId>DeepSigma.AI.FluentPromptBuilder</PackageId>
    <Description>A lightweight, extensible fluent prompt-building library for .NET.</Description>
    <PackageTags>ai;prompt;builder;openai;anthropic;llm</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.2.0</Version>

    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DeepSigma.AI.FluentPromptBuilder</Title>
    <Authors>DeepSigma LLC</Authors>
    <Company>$(Author)</Company>
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.AI.FluentPromptBuilder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.AI.FluentPromptBuilder</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>DeepSigma.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepSigma.AI.FluentPromptBuilder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="DeepSigma.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
