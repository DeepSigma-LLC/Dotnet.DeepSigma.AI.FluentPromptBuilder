<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DeepSigma.AI.FluentPromptBuilder.Postgres</RootNamespace>
    <AssemblyName>DeepSigma.AI.FluentPromptBuilder.Postgres</AssemblyName>
    <PackageId>DeepSigma.AI.FluentPromptBuilder.Postgres</PackageId>
    <Description>Postgres-backed IPromptRepository for DeepSigma.AI.FluentPromptBuilder, using Dapper and Npgsql.</Description>
    <PackageTags>ai;prompt;postgres;dapper;npgsql</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>1.1.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DeepSigma.AI.FluentPromptBuilder.Postrgres</Title>
    <Authors>DeepSigma LLC</Authors>
    <Company>$(Authors)</Company>
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.AI.FluentPromptBuilder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.AI.FluentPromptBuilder</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>DeepSigma.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSigma.AI.FluentPromptBuilder\DeepSigma.AI.FluentPromptBuilder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeepSigma.DataAccess.Postgres" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepSigma.AI.FluentPromptBuilder.Postgres.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\DeepSigma.AI.FluentPromptBuilder\DeepSigma.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
