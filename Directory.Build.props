<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- CA1716 fires on parameter names matching C++/VB reserved keywords. This library is .NET-only. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>DeepSigma</Authors>
    <Company>DeepSigma</Company>
    <Product>DeepSigma.AI.FluentPromptBuilder</Product>
    <Copyright>Copyright (c) DeepSigma</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
